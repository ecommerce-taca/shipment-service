# Local development only. Copy this file to .env and change values as needed.
# Never use these example credentials or tokens in production.

# 1. MySQL credentials and host port
MYSQL_ROOT_PASSWORD=local_root_change_me
MYSQL_DATABASE=shipmentdb
MYSQL_USER=shipment
MYSQL_PASSWORD=shipment_local_only
SHIPMENT_MYSQL_PORT=15406

# 2. Kafka listener and bootstrap addresses
# Host tools / host-run application use localhost; Compose services use kafka:9092.
SHIPMENT_KAFKA_PORT=19092
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka:9092

# 3. Shipment server, Spring profile, and application version
SHIPMENT_HTTP_PORT=18086
SERVER_PORT=8086
SPRING_PROFILES_ACTIVE=local
APP_ENV=local
APP_VERSION=0.2.0-SNAPSHOT

# 4. Database connections
# DB_URL is for running Shipment directly on the host.
# DB_URL_DOCKER is passed to the container; do not use localhost in this URL.
DB_URL=jdbc:mysql://localhost:15406/shipmentdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_URL_DOCKER=jdbc:mysql://shipment-mysql:3306/shipmentdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=shipment
DB_PASSWORD=shipment_local_only

# 5. Internal service token and trusted Gateway header enforcement
SHIPMENT_INTERNAL_TOKEN=local-dev-token-change-me
SHIPMENT_OPS_TOKEN=
SHIPMENT_ENFORCE_GATEWAY_HEADERS=true

# 6. Local mock carrier
SHIPMENT_MOCK_ENABLED=true

# 7. Kafka publisher, order-events consumer, and create-command consumer
SHIPMENT_KAFKA_PUBLISHER_ENABLED=true
# Keep the order.events.v1 consumer off unless its input contract is being tested.
SHIPMENT_KAFKA_CONSUMER_ENABLED=false
# Optional local proposal consumer; enable only when intentionally testing commands.
SHIPMENT_CREATE_CONSUMER_ENABLED=false
SHIPMENT_CREATE_CONSUMER_GROUP_ID=shipment-service-create-v1
SHIPMENT_CONSUMER_RETRY_COUNT=3
SHIPMENT_COMMAND_POLL_DELAY_MS=250
SHIPMENT_COMMAND_LEASE_SECONDS=120
SHIPMENT_OUTBOX_LEASE_SECONDS=60
SHIPMENT_RECONCILIATION_DELAY_MS=60000

# 8. Kafka topic names and producer timeouts/retries
SHIPMENT_EVENTS_TOPIC=shipment.events.v1
SHIPMENT_DLQ_TOPIC=shipment.events.dlq.v1
ORDER_EVENTS_TOPIC=order.events.v1
SHIPMENT_CREATE_COMMANDS_TOPIC=shipment.commands.v1
SHIPMENT_CONSUMER_DLQ_TOPIC=shipment.consumer.dlq.v1
SHIPMENT_KAFKA_SEND_TIMEOUT_MS=15000
OUTBOX_POLL_DELAY_MS=1000
SPRING_KAFKA_PRODUCER_RETRIES=3
SPRING_KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=5000
SPRING_KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=10000

# 9. Local webhook IP allowlist and mock signing secret (test-only)
SHIPMENT_WEBHOOK_ALLOWED_IPS=127.0.0.1,::1
SHIPMENT_WEBHOOK_MOCK_SECRET=local-mock-webhook-secret

# 10. Carrier webhook secrets; leave empty until carrier-specific verification is implemented.
SHIPMENT_WEBHOOK_GHN_SECRET=
SHIPMENT_WEBHOOK_SPX_SECRET=
SHIPMENT_WEBHOOK_JT_SECRET=

# 11. GHN integration remains disabled until its real API integration is verified.
GHN_ENABLED=false
GHN_BASE_URL=
GHN_TOKEN=
GHN_SHOP_ID=
